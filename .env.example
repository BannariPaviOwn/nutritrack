# NutriTrack environment variables
# Copy to .env.local and fill in values as needed.

# --- Auth (required for local mode sessions) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string

# --- Mode ---
# Leave Supabase vars empty to use the built-in local JSON store (data/store.json).
# Fill them in to use Supabase Auth + Postgres with RLS.

# --- Supabase (optional — preferred for multi-device / production) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role is NOT needed for the MVP (client + user RLS only).
