# NutriTrack environment variables
# Copy to .env.local and fill in values as needed.

# --- Auth (required for local mode sessions in production) ---
# Generate with: openssl rand -base64 32
# On Vercel: set AUTH_SECRET in Project → Settings → Environment Variables
# (or: echo <secret> | npx vercel env add AUTH_SECRET production)
AUTH_SECRET=replace-with-a-long-random-string

# --- Admin reports ---
# Comma-separated emails that may open /admin after normal login.
# Example: ADMIN_EMAILS=you@example.com,coach@nutritrack.local
ADMIN_EMAILS=

# --- Data mode ---
# local (default) — JSON store under data/store.json (or /tmp on Vercel).
#   Bundled demo template: data/templates/demo-store.json
# supabase — only when you explicitly opt in AND set URL + anon key.
DATA_MODE=local

# --- Supabase (optional — only used when DATA_MODE=supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role is NOT needed for the patient MVP (client + user RLS only).
# Admin cross-patient reports currently work in local mode; Supabase admin
# would need a server-only service role client (not configured here).
